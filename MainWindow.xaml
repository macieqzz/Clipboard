<Window x:Class="Clipwise.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipwise" Width="560" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        KeyDown="Window_OnKeyDown">
    <Border CornerRadius="12" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- search -->
            <Border Grid.Row="0" Margin="14,14,14,10" CornerRadius="8"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchTextBox}"
                                 VerticalAlignment="Center"
                                 TextChanged="SearchBox_OnTextChanged"/>
                        <StackPanel Orientation="Horizontal" IsHitTestVisible="False"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="Search clipboard" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="CountChip" Grid.Column="1" VerticalAlignment="Center"
                               FontFamily="{StaticResource AppFont}" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- list -->
            <ListBox x:Name="ClipList" Grid.Row="1" Margin="8,0,8,4"
                     ItemTemplate="{StaticResource ClipTemplate}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     PreviewMouseLeftButtonUp="ClipList_OnMouseUp"
                     SelectionChanged="ClipList_OnSelectionChanged"/>

            <!-- footer -->
            <Grid Grid.Row="2" Margin="14,4,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" FontFamily="{StaticResource AppFont}" FontSize="11"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           FontFamily="{StaticResource AppFont}" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
    </Border>
</Window>
