<Application x:Class="Clipwise.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- Win11 dark palette -->
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F2272727"/>
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FF1F1F1F"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F2FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#8CFFFFFF"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF"/>
        <SolidColorBrush x:Key="LiveBrush" Color="#FF6CCB5F"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#3D4CC2FF"/>
        <SolidColorBrush x:Key="ShelfBrush" Color="#0D000000"/>

        <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

        <!-- Rounded, dark, flat TextBox -->
        <Style x:Key="SearchTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="6,1" Padding="10,0"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectionBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slim modern scrollbar (vertical) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="4" Background="#59FFFFFF" Margin="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <DataTemplate x:Key="ClipTemplate">
            <Grid Height="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- source dot -->
                    <Border Width="6" Height="6" CornerRadius="3" Margin="0,0,10,0"
                            VerticalAlignment="Center" Background="{StaticResource LiveBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="ToolTip" Value="Captured live"/>
                                <Setter Property="Background" Value="{StaticResource LiveBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FromWinV}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="ToolTip" Value="From Windows history (Win+V)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <!-- image thumbnail -->
                    <Border CornerRadius="6" Width="40" Height="40" Margin="0,0,10,0"
                            Background="{StaticResource SurfaceAltBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="ClipToBounds" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="2"/>
                    </Border>

                    <TextBlock Text="{Binding Preview}" FontFamily="{StaticResource AppFont}"
                               FontSize="13" Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" TextWrapping="WrapWithOverflow"
                               MaxHeight="40" VerticalAlignment="Center" Width="330"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="11"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding TimestampLabel}" FontFamily="{StaticResource AppFont}"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

    </Application.Resources>
</Application>
